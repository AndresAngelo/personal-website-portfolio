{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "tagline": {
      "type": "string"
    },
    "problem": {
      "type": "string"
    },
    "role": {
      "type": "string"
    },
    "techStack": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "heroImage": {
      "type": "string"
    },
    "videoPitch": {
      "type": "string"
    },
    "pinned": {
      "type": "boolean"
    },
    "links": {
      "type": "object",
      "properties": {
        "repo": {
          "type": "string"
        },
        "demo": {
          "type": "string"
        },
        "caseStudy": {
          "type": "string"
        }
      }
    },
    "$schema": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "tagline",
    "problem",
    "role",
    "techStack"
  ]
}