{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "image": {
      "type": "string",
      "minLength": 1
    },
    "link": {
      "type": "string",
      "minLength": 1
    },
    "heroImage": {
      "type": "string",
      "minLength": 1
    },
    "videoPitch": {
      "type": "string",
      "format": "uri"
    },
    "pinned": {
      "type": "boolean"
    },
    "tagline": {
      "type": "string"
    },
    "problem": {
      "type": "string"
    },
    "role": {
      "type": "string"
    },
    "techStack": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "links": {
      "type": "object",
      "properties": {
        "repo": {
          "type": "string",
          "format": "uri"
        },
        "demo": {
          "type": "string",
          "format": "uri"
        },
        "caseStudy": {
          "type": "string",
          "format": "uri"
        }
      }
    },
    "$schema": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "description",
    "tags",
    "image",
    "link"
  ]
}