{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1
    },
    "date": {
      "type": "string"
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "location": {
      "type": "string",
      "minLength": 1
    },
    "backgroundImage": {
      "type": "string",
      "minLength": 1
    },
    "mediaType": {
      "type": "string",
      "enum": [
        "image",
        "video",
        "gallery"
      ]
    },
    "links": {
      "type": "object",
      "properties": {
        "eventPage": {
          "type": "string",
          "format": "uri"
        },
        "video": {
          "type": "string",
          "format": "uri"
        }
      }
    },
    "$schema": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "date",
    "description",
    "location"
  ]
}