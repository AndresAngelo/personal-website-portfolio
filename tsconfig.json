{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "jsx": "preserve",
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@components/*": ["src/components/*"]
    },
    "types": [
      "astro/client"
    ]
  },
  "include": [
    "astro.config.mjs",
    "src/**/*",
    "public/**/*.json"
  ],
  "exclude": [
    "node_modules",
    ".vercel",
    "dist"
  ]
}
