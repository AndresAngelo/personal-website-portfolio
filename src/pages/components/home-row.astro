---
/**
 * Hero section component for the personal portfolio.
 */

interface SocialLink {
  url: string;
  label?: string;
  title?: string;
  icon?: string;
}

interface Props {
  title?: string;
  subtitle?: string;
  githubUrl?: string;
  linkedinUrl?: string;
  image?: string;
  layoutClass?: string;
  socialLinks?: SocialLink[];
}

const {
  title = "Hi, I'm Angelo.",
  subtitle = "Full-stack developer · Designer · Problem solver.",
  githubUrl = "https://github.com",
  linkedinUrl = "https://linkedin.com",
  image = "/images/hero-illustration.svg",
  layoutClass = "grid-cols-1 md:grid-cols-[auto,auto_1fr]",
  socialLinks = [],
} = Astro.props;
---

<section class="home-row" id="home">
  <div class="home-row__inner fade-in">
    <div class={`grid gap-8 ${layoutClass}`}>
      <div class="home-row__content flex flex-col items-center justify-start">
        <h1 class="home-row__title text-4xl sm:text-5xl md:text-6xl font-bold tracking-tight text-slate-900 dark:text-slate-100">
          {title}
        </h1>
        <p class="home-row__subtitle mt-4 text-lg sm:text-xl text-slate-600 dark:text-slate-300 max-w-md text-center md:text-left">
          {subtitle}
        </p>

        <div class="home-row__ctas mt-6 flex flex-col sm:flex-row gap-3 items-center">
          <a href={githubUrl} target="_blank" rel="noopener noreferrer" class="btn btn-primary inline-flex items-center gap-2 px-5 py-2.5 rounded-lg font-medium text-sm bg-slate-900 text-white hover:bg-slate-700 dark:bg-slate-100 dark:text-slate-900 dark:hover:bg-slate-300 transition-colors">
            GitHub
          </a>
          <a href={linkedinUrl} target="_blank" rel="noopener noreferrer" class="btn btn-secondary inline-flex items-center gap-2 px-5 py-2.5 rounded-lg font-medium text-sm bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700 transition-colors">
            LinkedIn
          </a>
        </div>

        {socialLinks.length > 0 && (
          <div class="home-row__socials mt-6 flex items-center gap-4">
            {socialLinks.map((link) => (
              <a href={link.url} target="_blank" rel="noopener noreferrer" title={link.title || link.label} aria-label={link.title || link.label} class="social-link group inline-flex items-center justify-center w-10 h-10 rounded-full bg-slate-100 dark:bg-slate-800 hover:bg-indigo-50 dark:hover:bg-indigo-950 text-slate-600 dark:text-slate-300 hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors">
                {link.icon ? <span set:html={link.icon} /> : link.label}
              </a>
            ))}
          </div>
        )}
      </div>

      <div class="home-row__visual hidden md:flex flex-col items-center justify-center">
        <img src={image} alt="" class="w-64 h-auto object-contain" loading="lazy" width="256" />
      </div>
    </div>
  </div>
</section>

<style>
  .home-row {
    position: relative;
    overflow-x: hidden;
  }

  .home-row__inner {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: calc(100vh - 64px);
    padding: clamp(2rem, 4vw, 5rem) 0;
  }

  .home-row__title {
    line-height: 1.1;
    letter-spacing: -0.02em;
  }

  .home-row__subtitle {
    max-width: 60ch;
  }

  .fade-in {
    opacity: 0;
    transform: translateY(8px);
    transition-property: opacity, transform;
    transition-duration: 500ms;
    will-change: opacity, transform;
  }

  .fade-in.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  .social-link:hover svg path {
    fill: currentColor;
  }
</style>
