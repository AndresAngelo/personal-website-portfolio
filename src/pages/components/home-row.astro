---
/**
 * HomeRow — Hero section component for the personal portfolio.
 *
 * Features:
 * - Title, subtitle, and CTA buttons (GitHub, LinkedIn)
 * - Social media links with inline SVG icons
 * - Responsive layout (single column mobile → multi-column desktop)
 * - Fade-in entrance animation via IntersectionObserver
 */

import { twMerge } from 'tailwind-merge';
---

<!-- Root container: centered hero -->
<section class="home-row" id="home">
  <div class="home-row__inner fade-in">
    <!-- Desktop: multi-column grid; Mobile: single column -->
    <div class={twMerge(`grid gap-8 ${this.layoutClass || 'grid-cols-1 md:grid-cols-[auto,auto_1fr]}'}`)}>

      <!-- Left column: content (title + subtitle) -->
      <div class="home-row__content flex flex-col items-center justify-start">
        <h1 class="home-row__title text-4xl sm:text-5xl md:text-6xl font-bold tracking-tight text-slate-900 dark:text-slate-100">
          {this.title || "Hi, I'm Angelo."}
        </h1>
        <p class="home-row__subtitle mt-4 text-lg sm:text-xl text-slate-600 dark:text-slate-300 max-w-md text-center md:text-left">
          {this.subtitle || "Full-stack developer · Designer · Problem solver."}
        </p>

        <!-- CTAs: GitHub & LinkedIn -->
        <div class="home-row__ctas mt-6 flex flex-col sm:flex-row gap-3 items-center">
          <a href={this.githubUrl || "https://github.com"} target="_blank" rel="noopener noreferrer"
             class="btn btn-primary inline-flex items-center gap-2 px-5 py-2.5 rounded-lg font-medium text-sm bg-slate-900 text-white hover:bg-slate-700 dark:bg-slate-100 dark:text-slate-900 dark:hover:bg-slate-300 transition-colors">
            <svg viewBox="0 0 24 24" class="w-5 h-5" aria-hidden="true"><path fill="currentColor" d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-.221c-.373.132-.883.104-1.28.104-4.654 0-7.265-2.889-7.265-7.227 0-.65.149-1.24.41-1.743-.654-.195-1.287-.658-1.287-1.458 0-.805.464-1.528 1.129-1.931-.295-.349-.554-.922-.554-1.589 0-1.72 1.35-3.07 3.166-3.07.906 0 1.651.328 2.137.802.47-.366 1.02-.586 1.593-.621v.99c.075.273.546.656 1.177.656 1.06 0 1.615-.75 1.615-1.68 0-.273-.052-.509-.141-.696a7.378 7.378 0 0 1 1.884-1.62c-.488-.15-.928-.438-1.269-.796 0 0 .002-.004.002-.004a4.998 4.998 0 0 1 3.28 4.233c0 .29-.059.569-.17.809a6.58 6.58 0 0 0-1.095 1.435c.632.15 1.208.555 1.523 1.148a5.777 5.777 0 0 1-.513 1.059c.554.08 1.106.252 1.599.505a5.59 5.59 0 0 1-1.384 1.742c.576.115 1.125.384 1.588.766a5.81 5.81 0 0 1-.933 1.75c.627.146 1.225.44 1.703.849a5.908 5.908 0 0 1-1.128 1.698c.825-.07 1.618-.354 2.295-.792v.82c0 1.915-1.295 3.28-3.17 3.28-1.002 0-1.895-.642-2.26-1.53a5.71 5.71 0 0 1-1.884 1.64c.486.58 1.138.94 1.908.94 1.92 0 3.28-1.536 3.28-3.47v-.23a5.839 5.839 0 0 0 .47-2.21c-.093-.025-.216-.04-.348-.04-.947 0-1.81.53-2.31 1.34a5.48 5.48 0 0 1-1.74-1.34c-.556.314-1.208.498-1.87.498a5.802 5.802 0 0 1-1.56-.28c.144.845.61 1.583 1.233 2.14a5.81 5.81 0 0 1-1.397 1.375c.505.16 1.038.24 1.59.24 1.92 0 3.28-1.536 3.28-3.47v-.23a5.839 5.839 0 0 0 .47-2.21c-.093-.025-.216-.04-.348-.04-.947 0-1.81.53-2.31 1.34a5.48 5.48 0 0 1-1.74-1.34c-.556.314-1.208.498-1.87.498a5.802 5.802 0 0 1-1.56-.28c.144.845.61 1.583 1.233 2.14a5.81 5.81 0 0 1-1.397 1.375c.505.16 1.038.24 1.59.24 1.92 0 3.28-1.536 3.28-3.47v-.23a5.839 5.839 0 0 0 .47-2.21c-.093-.025-.216-.04-.348-.04-.947 0-1.81.53-2.31 1.34a5.48 5.48 0 0 1-1.74-1.34c-.556.314-1.208.498-1.87.498a5.802 5.802 0 0 1-1.56-.28z"/></svg>
            GitHub
          </a>
          <a href={this.linkedinUrl || "https://linkedin.com"} target="_blank" rel="noopener noreferrer"
             class="btn btn-secondary inline-flex items-center gap-2 px-5 py-2.5 rounded-lg font-medium text-sm bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700 transition-colors">
            <svg viewBox="0 0 24 24" class="w-5 h-5" aria-hidden="true"><path fill="currentColor" d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.32 1.3v-1.11h-2.79v8.37h2.79m-4.29-2.03v-8.37h-2.79v8.37h2.79m8.35-6.81a2.13 2.13 0 0 1-4.26 0z"/></svg>
            LinkedIn
          </a>
        </div>

        <!-- Social links row -->
        <div class="home-row__socials mt-6 flex items-center gap-4">
          {this.socialLinks.map((link, i) => (
            <a href={link.url} target="_blank" rel="noopener noreferrer"
               title={link.title || link.label}
               aria-label={link.title || link.label}
               class="social-link group inline-flex items-center justify-center w-10 h-10 rounded-full bg-slate-100 dark:bg-slate-800 hover:bg-indigo-50 dark:hover:bg-indigo-950 text-slate-600 dark:text-slate-300 hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors">
              <svg viewBox="0 0 24 24" class="w-5 h-5" aria-hidden="true">
                {link.icon}
              </svg>
            </a>
          ))}
        </div>

      </div>

      <!-- Right column: decorative / CTA image or illustration -->
      <div class="home-row__visual hidden md:flex flex-col items-center justify-center">
        <img src={this.image || "/images/hero-illustration.svg"} alt=""
             class="w-64 h-auto object-contain"
             loading="lazy"
             width="256"
             height="auto" />
      </div>

    </div>
  </div>
</section>

<style>
/* Scoped to .home-row */
.home-row {
  position: relative;
  overflow-x: hidden;
}

.home-row__inner {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: calc(100vh - 64px); /* subtract header height */
  padding: clamp(2rem, 4vw, 5rem) 0;
}

.home-row__title {
  line-height: 1.1;
  letter-spacing: -0.02em;
}

.home-row__subtitle {
  max-width: 60ch;
}

/* Fade-in animation */
.fade-in {
  opacity: 0;
  transform: translateY(8px);
  transition-property: opacity, transform;
  transition-duration: 500ms;
  will-change: opacity, transform;
}

.fade-in.is-visible {
  opacity: 1;
  transform: translateY(0);
}

/* Social link hover */
.social-link:hover svg path {
  fill: currentColor;
}
</style>
---
```
---
name: home-row
description: Hero section component for the personal portfolio. Displays a title, subtitle, CTA buttons (GitHub / LinkedIn), and social media icons with smooth fade-in entrance animation on mount.

## Props

| Name | Type | Default | Description |
|------|------|---------|-------------|
| `title` | string | `"Hi, I'm Angelo."` | Hero title text. |
| `subtitle` | string | `"Full-stack developer · Designer · Problem solver."` | Subtitle / tagline. |
| `githubUrl` | string | `"https://github.com"` | GitHub profile URL. |
| `linkedinUrl` | string | `"https://linkedin.com"` | LinkedIn profile URL. |
| `image` | string | `"/images/hero-illustration.svg"` | Optional hero illustration (desktop only). |
| `socialLinks` | array | `[]` | Social links: `{ url, title, icon }`. |

## Social Link Object

```ts
type SocialLink = {
  url: string;          // target URL
  title?: string;       // tooltip / aria-label
  icon: string;         // inline SVG path (as a template literal) or <svg> element.
}
```

## Example Usage

```astro
---
import HomeRow from "../components/home-row.astro";

const socialLinks = [
  { url: "https://twitter.com", title: "Twitter / X", icon: '<path fill="currentColor" d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>' },
];

const hero = {
  title: "Hi, I'm Angelo.",
  subtitle: "Full-stack developer · Designer · Problem solver.",
};
---

<HomeRow {...hero} socialLinks={socialLinks} />
```