---
import ActivitiesRow from '../components/rows/ActivitiesRow.astro';
import ContactRow from '../components/rows/ContactRow.astro';
import ExperienceRow from '../components/rows/ExperienceRow.astro';
import HomeRow from '../components/rows/HomeRow.astro';
import ProjectsRow from '../components/rows/ProjectsRow.astro';
import SidebarNav from '../components/SidebarNav.astro';
import ChatWidget from '../components/ChatWidget.astro';
import { getLanguageFromPath, t } from '../lib/i18n';
const language = getLanguageFromPath(Astro.url.pathname);
---
<link rel="manifest" href="/manifest.webmanifest" />
<SidebarNav />
<main class="portfolio-content">
  <HomeRow title={t(language, 'site.title')} subtitle={t(language, 'site.description')} ctaText={t(language, 'navigation.projects')} ctaUrl="#projects" />
  <ProjectsRow />
  <ActivitiesRow title={t(language, 'navigation.activities')} />
  <ExperienceRow title={t(language, 'navigation.experience')} />
  <ContactRow title={t(language, 'contact.getInTouch')} subtitle={t(language, 'contact.subtitle')} email="hello@example.com" />
</main>
<ChatWidget />
<script>
  if ('serviceWorker' in navigator) {
    window.addEventListener('load', () => navigator.serviceWorker.register('/sw.js'));
  }
</script>
<script>
  const animatedRows = [...document.querySelectorAll<HTMLElement>('.portfolio-content > section')];
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (animatedRows.length && !prefersReducedMotion) {
    const content = document.querySelector<HTMLElement>('.portfolio-content');
    content?.classList.add('supports-row-animation');

    const observer = new IntersectionObserver((entries, currentObserver) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        entry.target.classList.add('is-visible');
        currentObserver.unobserve(entry.target);
      });
    }, { rootMargin: '0px 0px -12% 0px', threshold: 0.08 });

    animatedRows.forEach((row) => observer.observe(row));
  }
</script>
<style>
  .portfolio-content { display: flex; flex-direction: column; min-height: 100vh; padding-inline: clamp(1rem, 7vw, 8rem); }
  .portfolio-content > :global(section) { scroll-margin-top: 1rem; }
  .portfolio-content.supports-row-animation > :global(section) {
    opacity: 0;
    transform: translateY(1.25rem);
    transition: opacity 550ms ease, transform 550ms ease;
    will-change: opacity, transform;
  }
  .portfolio-content.supports-row-animation > :global(section.is-visible) {
    opacity: 1;
    transform: translateY(0);
  }
  @media (prefers-reduced-motion: reduce) {
    .portfolio-content > :global(section) { scroll-margin-top: 1rem; }
  }
  @media (max-width: 767px) { .portfolio-content { padding-inline: 0; padding-top: 4rem; } }
</style>
