---
import Layout from '../../layouts/Layout.astro';

/** @type { import('astro'). AstroComponentProps } */
interface Props {
  title: string;
}

const { title = "Projects" } = Astro.props;
---

<main class="min-h-screen flex items-center justify-center px-4 sm:px-6 lg:px-8">
  
  <div class="max-w-5xl mx-auto text-center space-y-8 py-12 md:py-20">
    
    <!-- Heading -->
    <h1 class="text-3xl sm:text-4xl font-bold tracking-tight">
      <span class="bg-gradient-to-r from-indigo-400 via-purple-400 to-pink-400 bg-clip-text text-transparent">
        {title}
      </span>
    </h1>

    <!-- Subheading -->
    <p class="text-lg sm:text-xl text-slate-400 max-w-2xl mx-auto leading-relaxed">
      A collection of my personal and professional projects. Each one demonstrates a different skill or technology I've worked with.
    </p>

  </div>

</main>
---