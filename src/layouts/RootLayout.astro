---
import LanguageSelector from '../components/LanguageSelector.astro';
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{ title } — AEA Personal Portfolio</title>
  
  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  
  <!-- Meta Tags for SEO -->
  <meta name="description" content="{ description || 'A personal portfolio website built with Astro.' }" />
  <meta name="author" content="AEA" />
  
  <!-- Open Graph / Social Cards -->
  <meta property="og:type" content="website" />
  <meta property="og:title" content="{ title } — AEA Personal Portfolio" />
  <meta property="og:description" content="{ description || 'A personal portfolio website built with Astro.' }" />
  <meta property="og:image" content="/og-image.png" />
  
  <!-- CSS -->
  <link rel="stylesheet" href="/styles/main.css" />
  
  <!-- Preload critical assets -->
  <link rel="preload" as="image" href="/favicon.svg" />
</head>

<body class="bg-slate-900 text-slate-100 antialiased">
  <div class="min-h-screen flex flex-col">
    
    <!-- Header Component (inline for simplicity) -->
    <header class="sticky top-0 z-50 border-b border-slate-800/60 bg-slate-900/80 backdrop-blur-md">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-center justify-between h-16">
          
          <!-- Site Title -->
          <a href="/" class="flex items-center space-x-3 group" aria-label="AEA Portfolio Home">
            <div class="w-9 h-9 rounded-lg bg-gradient-to-br from-indigo-500 via-purple-500 to-pink-500 flex items-center justify-center shadow-lg shadow-indigo-500/20 transition-transform group-hover:scale-105">
              <svg class="w-5 h-5 text-white" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1" />
              </svg>
            </div>
            <span class="text-xl font-bold bg-gradient-to-r from-indigo-400 via-purple-400 to-pink-400 bg-clip-text text-transparent">
              AEA Portfolio
            </span>
          </a>
          
          <!-- Navigation -->
          <nav class="hidden md:flex items-center space-x-1" aria-label="Main navigation">
            <a href="/" class="px-4 py-2 rounded-lg text-sm font-medium text-slate-300 hover:text-white hover:bg-slate-800/50 transition-colors focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2 focus:ring-offset-slate-900">
              Home
            </a>
            <a href="/#about" class="px-4 py-2 rounded-lg text-sm font-medium text-slate-300 hover:text-white hover:bg-slate-800/50 transition-colors focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2 focus:ring-offset-slate-900">
              About
            </a>
            <a href="/#projects" class="px-4 py-2 rounded-lg text-sm font-medium text-slate-300 hover:text-white hover:bg-slate-800/50 transition-colors focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2 focus:ring-offset-slate-900">
              Projects
            </a>
            <a href="/#experience" class="px-4 py-2 rounded-lg text-sm font-medium text-slate-300 hover:text-white hover:bg-slate-800/50 transition-colors focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2 focus:ring-offset-slate-900">
              Experience
            </a>
            <a href="/#contact" class="px-4 py-2 rounded-lg text-sm font-medium bg-gradient-to-r from-indigo-600 to-purple-600 text-white hover:from-indigo-500 hover:to-purple-500 transition-all focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2 focus:ring-offset-slate-900">
              Contact
            </a>
          </nav>

          <LanguageSelector />
          
          <!-- Mobile menu button -->
          <button 
            class="md:hidden p-2 rounded-lg text-slate-300 hover:bg-slate-800/50 focus:outline-none focus:ring-2 focus:ring-indigo-500"
            aria-label="Toggle navigation menu"
            type="button"
          >
            <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
            </svg>
          </button>
        </div>
      </div>
    </header>

    <!-- Main Content Area -->
    <main class="flex-grow">
      { yield }
    </main>

    <!-- Footer Component (inline for simplicity) -->
    <footer class="border-t border-slate-800/60 bg-slate-950/50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 lg:gap-12">
          
          <!-- Brand Section -->
          <div class="space-y-4">
            <h3 class="text-lg font-semibold text-slate-200">AEA Portfolio</h3>
            <p class="text-sm text-slate-400 max-w-xs">
              A personal portfolio website built with Astro, showcasing my work and experiences.
            </p>
          </div>
          
          <!-- Social Links -->
          <nav aria-label="Social navigation" class="space-y-3">
            <h4 class="text-sm font-medium text-slate-400 uppercase tracking-wider">Connect</h4>
            <a href="#" class="flex items-center space-x-2 text-sm text-slate-400 hover:text-indigo-400 transition-colors focus:outline-none focus:text-indigo-400" aria-label="GitHub profile">
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.013-1.416-4.013-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.416-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.93 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.312.833 1.123.833 2.246v3.09c0 .316.194.69.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/></svg>
              <span>GitHub</span>
            </a>
            <a href="#" class="flex items-center space-x-2 text-sm text-slate-400 hover:text-indigo-400 transition-colors focus:outline-none focus:text-indigo-400" aria-label="LinkedIn profile">
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.967c1.394-2.285 3.796-2.285 3.796 0v9.033z"/></svg>
              <span>LinkedIn</span>
            </a>
            <a href="#" class="flex items-center space-x-2 text-sm text-slate-400 hover:text-indigo-400 transition-colors focus:outline-none focus:text-indigo-400" aria-label="Twitter profile">
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
              <span>Twitter</span>
            </a>
          </nav>
          
          <!-- Copyright -->
          <div class="space-y-4">
            <h4 class="text-sm font-medium text-slate-400 uppercase tracking-wider">Legal</h4>
            <p class="text-xs text-slate-500">
              &copy; { new Date().getFullYear() } AEA. All rights reserved.
            </p>
            <a href="/privacy-policy" class="text-xs text-indigo-300 hover:text-indigo-200 transition-colors">Privacy Policy</a>
            <p class="text-xs text-slate-600">
              Built with <span class="text-indigo-400">&lt;Astro /&gt;</span> on Vercel.
            </p>
          </div>
        </div>
      </div>
    </footer>

  </div>
</body>
</html>
