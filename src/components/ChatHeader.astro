---
interface Props {
  title?: string;
  eyebrow?: string;
}

const { title = 'Ask about my work', eyebrow = 'Portfolio assistant' } = Astro.props;
---

<header class="chat-panel-header">
  <div>
    <p class="chat-eyebrow">{eyebrow}</p>
    <h2 id="chat-title">{title}</h2>
  </div>
  <button class="chat-clear" type="button" data-chat-clear aria-label="Clear conversation history">Clear</button>
  <button class="chat-close" type="button" data-chat-close aria-label="Close portfolio assistant">
    <span aria-hidden="true">×</span>
  </button>
</header>

<style>
  .chat-panel-header { display: flex; align-items: flex-start; justify-content: space-between; gap: .5rem; padding: 1rem 1.125rem; background: linear-gradient(135deg, rgb(79 70 229 / 35%), rgb(147 51 234 / 25%)); }
  .chat-panel h2 { margin: 0; color: #f8fafc; font-size: 1rem; }
  .chat-eyebrow { margin: 0 0 .25rem; color: #c4b5fd; font-size: .7rem; font-weight: 700; text-transform: uppercase; }
  .chat-close { min-width: 2.75rem; min-height: 2.75rem; padding: .1rem .35rem; border: 0; border-radius: .5rem; color: #cbd5e1; background: transparent; cursor: pointer; font: inherit; font-size: 1.5rem; line-height: 1; }
  .chat-clear { min-height: 2.25rem; padding: .25rem .5rem; border: 1px solid rgb(196 181 253 / 45%); border-radius: .4rem; color: #e9d5ff; background: transparent; cursor: pointer; font: inherit; font-size: .7rem; }
  .chat-clear:hover, .chat-clear:focus-visible { color: #fff; background: rgb(255 255 255 / 12%); }
  .chat-close:hover, .chat-close:focus-visible { color: #fff; background: rgb(255 255 255 / 12%); }
  .chat-close:focus-visible { outline: 2px solid #c4b5fd; outline-offset: 2px; }
  @media (max-width: 360px) { .chat-panel-header { padding-inline: .75rem; } .chat-panel-header > div { min-width: 0; } .chat-panel h2 { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; } .chat-clear { padding-inline: .35rem; } }
</style>
