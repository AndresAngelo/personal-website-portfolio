---
/** @type {import('astro').PartialAstroProps} */
interface Props {
  title?: string;
  activities?: Array<{
    title: string;
    description: string;
    date: string;
    type?: "work" | "personal" | "community";
    link?: string;
  }>;
}

const props = Astro.props as Props;

// Format date for display
function formatDate(dateString: string): string {
  const date = new Date(dateString);
  return date.toLocaleDateString("en-US", {
    year: "numeric",
    month: "long",
    day: "numeric",
  });
}

const emptyActivitiesMessage = "No activities yet. This section will display your experience timeline.";
---

<section class="activities-row" id="activities">
  <div class="row-header">
    <h2>{props.title ?? 'Activities'}</h2>
    {props.activities?.length === 0 ? (
      <p class="empty-message">{emptyActivitiesMessage}</p>
    ) : null}
  </div>

  <div class="timeline-container">
    {props.activities?.map((activity, index) => (
      <a 
        href={activity.link || "#"} 
        class="activity-item"
        role="listitem"
        tabindex="0"
        aria-label={`${formatDate(activity.date)} — ${activity.title}`}
      >
        <div class="timeline-line"></div>

        <div class="activity-content">
          {activity.type === "personal" ? (
            <span class="type-badge personal">Personal</span>
          ) : activity.type === "community" ? (
            <span class="type-badge community">Community</span>
          ) : (
            <span class="type-badge work">Work</span>
          )}

          <div class="activity-details">
            <h3>{activity.title}</h3>
            <p class="date">{formatDate(activity.date)}</p>
            <p class="description">{activity.description}</p>
          </div>

          <span class="arrow-right">→</span>
        </div>
      </a>
    ))}
  </div>
</section>

<style>
  .activities-row {
    padding: 4rem 2rem;
    background: #fff;
  }

  .row-header {
    max-width: 100%;
    margin-bottom: 3rem;
  }

  .row-header h2 {
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    font-weight: 700;
    color: #1a1a2e;
    margin: 0 0 1rem;
  }

  .empty-message {
    color: #718096;
    padding: 0.5rem 0;
    font-size: 0.95rem;
  }

  .timeline-container {
    position: relative;
    max-width: 800px;
    margin: 0 auto;
  }

  .activity-item {
    display: flex;
    align-items: center;
    padding: 1.5rem 2rem;
    background: #fff;
    border-radius: 14px;
    text-decoration: none;
    transition: transform 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94),
                box-shadow 0.3s ease,
                border-color 0.3s ease;
    cursor: pointer;
    position: relative;
  }

  .activity-item:hover {
    transform: translateX(8px);
    box-shadow: 0 12px 35px rgba(0, 0, 0, 0.1);
    border-color: #667eea;
  }

  .activity-item:focus-visible {
    outline: none;
    ring: 3px solid #667eea;
    box-shadow: 0 0 0 8px rgba(102, 126, 234, 0.25);
  }

  .timeline-line {
    position: absolute;
    left: -1rem;
    top: 50%;
    transform: translateY(-50%);
    width: calc(100vw + 2rem);
    height: 3px;
    background: #e9ecef;
    border-radius: 3px;
  }

  .activity-content {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    width: 100%;
  }

  .type-badge {
    padding: 0.3em 0.75em;
    border-radius: 99px;
    font-size: clamp(0.675rem, 1vw, 0.725rem);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    flex-shrink: 0;
  }

  .type-badge.work {
    background: #e9ecef;
    color: #4a5568;
  }

  .type-badge.personal {
    background: #d4edda;
    color: #155724;
  }

  .type-badge.community {
    background: #cce5ff;
    color: #004085;
  }

  .activity-details h3 {
    font-size: clamp(1.1rem, 2vw, 1.35rem);
    margin: 0 0 0.35em;
    color: #1a1a2e;
  }

  .activity-details .date {
    font-size: clamp(0.75rem, 1.2vw, 0.85rem);
    color: #9aa5b1;
    margin-bottom: 0.3em;
  }

  .activity-details .description {
    font-size: clamp(0.85rem, 1.3vw, 1rem);
    color: #4a5568;
    line-height: 1.5;
    margin: 0;
  }

  .arrow-right {
    flex-shrink: 0;
    font-size: clamp(1.2rem, 3vw, 1.5rem);
    color: #667eea;
  }

  @media (max-width: 768px) {
    .activities-row {
      padding: 3rem 1.5rem;
    }

    .activity-item {
      padding: 1.25rem 1.5rem;
    }
  }
</style>
---
