---
/** @type {import('astro').PartialAstroProps} */
interface Props {
  title: string;
  subtitle?: string;
  ctaText?: string;
  ctaUrl?: string;
  socialLinks?: Record<string, string>;
}

const props = Astro.props as Props;

const socialIcons = {
  github: "https://github.com",
  linkedin: "https://linkedin.com",
  twitter: "https://twitter.com",
};
---

<section class="home-row" id="home">
  <div class="hero-container">
    <h1 class="hero-title">{props.title}</h1>
    {props.subtitle ? <p class="hero-subtitle">{props.subtitle}</p> : null}
    
    {props.ctaText && props.ctaUrl ? (
      <a href={props.ctaUrl} class="cta-button">
        {props.ctaText} →
      </a>
    ) : null}

    <div class="social-links">
      {Object.entries(socialIcons).map(([platform, url]) => (
        <a 
          href={url} 
          target="_blank" 
          rel="noopener noreferrer"
          class="social-link"
          aria-label={`Visit ${platform}`}
        >
          <svg class="social-icon" width="24" height="24" aria-hidden="true">
            <circle cx="12" cy="12" r="9" />
          </svg>
        </a>
      ))}
    </div>
  </div>

  <div class="hero-decoration">
    <span class="decoration-line"></span>
  </div>
</section>

<style>
  .home-row {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 4rem 2rem;
    background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
    position: relative;
    overflow: hidden;
  }

  .hero-container {
    max-width: 640px;
    text-align: center;
    z-index: 2;
  }

  .hero-title {
    font-size: clamp(2.5rem, 8vw, 5rem);
    font-weight: 800;
    line-height: 1.1;
    margin-bottom: 1.5rem;
    color: #1a1a2e;
    letter-spacing: -0.02em;
  }

  .hero-subtitle {
    font-size: clamp(1rem, 3vw, 1.25rem);
    line-height: 1.6;
    margin-bottom: 2rem;
    color: #4a5568;
  }

  .cta-button {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    padding: 0.9rem 1.75rem;
    background: #2d3748;
    color: #fff;
    text-decoration: none;
    font-weight: 600;
    border-radius: 999px;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .cta-button:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 25px rgba(45, 55, 72, 0.3);
  }

  .social-links {
    display: flex;
    justify-content: center;
    gap: 1rem;
    margin-top: 2rem;
  }

  .social-link {
    width: 48px;
    height: 48px;
    display: grid;
    place-items: center;
    background: #2d3748;
    color: #fff;
    border-radius: 50%;
    text-decoration: none;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .social-link:hover {
    transform: translateY(-3px) scale(1.08);
    box-shadow: 0 8px 25px rgba(45, 55, 72, 0.3);
  }

  .social-icon {
    fill: currentColor;
  }

  .hero-decoration {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .decoration-line {
    position: absolute;
    top: -50px;
    left: 20%;
    width: 60%;
    height: 1px;
    background: linear-gradient(90deg, transparent, #e2e8f0, transparent);
  }

  @media (max-width: 768px) {
    .home-row {
      padding: 3rem 1.5rem;
    }

    .hero-title {
      font-size: clamp(2rem, 10vw, 4rem);
    }
  }
</style>
