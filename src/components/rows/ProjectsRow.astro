---
import { getCollection } from 'astro:content';
import { sortPinnedProjects } from '../../lib/projects';
import ProjectsGrid from "../ProjectsRow.astro";

interface Props {
  projects?: Array<{
    id: string;
    title: string;
    description: string;
    tags: string[];
    image?: string;
    link?: string;
    heroImage?: string;
    pinned?: boolean;
  }>;
}

const { projects: providedProjects } = Astro.props as Props;
const projects = providedProjects ?? sortPinnedProjects((await getCollection('projects')).map(({ id, data }) => ({ id, ...data })));
---

<ProjectsGrid projects={projects} />
