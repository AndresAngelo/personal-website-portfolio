---
import CitationDisplay, { type Citation } from './CitationDisplay.astro';

export interface ChatMessage {
  id?: string;
  role: 'user' | 'assistant';
  content: string;
  timestamp?: string | Date;
  citations?: Citation[];
}

interface Props {
  messages?: ChatMessage[];
  emptyMessage?: string;
}

const { messages = [], emptyMessage = 'Your conversation will appear here.' } = Astro.props;

function formatTimestamp(timestamp?: string | Date) {
  if (!timestamp) return '';

  const date = timestamp instanceof Date ? timestamp : new Date(timestamp);
  if (Number.isNaN(date.getTime())) return '';

  return new Intl.DateTimeFormat('en', { hour: 'numeric', minute: '2-digit' }).format(date);
}
---

<div class="chat-messages" data-chat-messages aria-live="polite" aria-label="Conversation messages">
  {messages.length === 0 ? (
    <p class="chat-messages-empty">{emptyMessage}</p>
  ) : (
    messages.map((message, index) => (
      <article class:list={['chat-message', `chat-message-${message.role}`]} data-message-role={message.role}>
        <p class="chat-message-label">{message.role === 'user' ? 'You' : 'Assistant'}</p>
        <p class="chat-message-content">
          {message.content.split(/(\[\d+\])/g).map((part) =>
            /^\[\d+\]$/.test(part)
              ? <a class="inline-citation" href={`#citation-${part.slice(1, -1)}`} aria-label={`View source ${part.slice(1, -1)}`}>{part}</a>
              : part
          )}
        </p>
        {message.role === 'assistant' && <CitationDisplay citations={message.citations} />}
        {message.timestamp && (
          <time class="chat-message-time" datetime={message.timestamp instanceof Date ? message.timestamp.toISOString() : message.timestamp}>
            {formatTimestamp(message.timestamp)}
          </time>
        )}
        {index === messages.length - 1 && <span class="sr-only">Latest message</span>}
      </article>
    ))
  )}
</div>

<style>
  .chat-messages { display: flex; flex: 1; flex-direction: column; gap: .75rem; min-height: 10rem; max-height: 22rem; overflow-y: auto; padding: 1rem; background: #0f172a; scroll-behavior: smooth; }
  .chat-message { max-width: min(88%, 32rem); padding: .7rem .8rem; border: 1px solid rgb(148 163 184 / 18%); border-radius: .8rem; color: #e2e8f0; background: #1e293b; }
  .chat-message-user { align-self: flex-end; border-color: rgb(165 180 252 / 28%); color: #eef2ff; background: #3730a3; }
  .chat-message-label, .chat-message-content, .chat-message-time { margin: 0; }
  .chat-message-label { color: #c4b5fd; font-size: .68rem; font-weight: 700; letter-spacing: .04em; text-transform: uppercase; }
  .chat-message-user .chat-message-label { color: #ddd6fe; }
  .chat-message-content { margin-top: .25rem; white-space: pre-wrap; overflow-wrap: anywhere; font-size: .88rem; line-height: 1.45; }
  .inline-citation { color: #c4b5fd; font-weight: 700; text-decoration: underline; text-underline-offset: 2px; }
  .chat-message-time { display: block; margin-top: .45rem; color: #94a3b8; font-size: .68rem; }
  .chat-messages-empty { align-self: center; max-width: 18rem; margin: auto; color: #94a3b8; font-size: .85rem; line-height: 1.5; text-align: center; }
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }
  @media (max-width: 480px) { .chat-messages { padding: .75rem; } .chat-message { max-width: 94%; } }
  @media (prefers-reduced-motion: reduce) { .chat-messages { scroll-behavior: auto; } }
</style>
