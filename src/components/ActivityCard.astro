---
interface ActivityLinks {
  eventPage?: string;
  video?: string;
}

interface ActivityData {
  title: string;
  date: string;
  description: string;
  location: string;
  backgroundImage?: string;
  mediaType?: 'image' | 'video' | 'gallery';
  links?: ActivityLinks;
}

interface Props {
  activity: ActivityData;
  id?: string;
}

const { activity, id } = Astro.props;
const formattedDate = new Date(`${activity.date}T00:00:00Z`).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'UTC',
});
const activityLink = activity.links?.eventPage ?? activity.links?.video;
---

<article class="activity-card" id={id}>
  <div class="activity-card__marker" aria-hidden="true"></div>
  {activity.backgroundImage && (
    <img
      class="activity-card__image"
      src={activity.backgroundImage}
      alt=""
      loading="lazy"
      decoding="async"
      width="640"
      height="360"
    />
  )}

  <div class="activity-card__content">
    <div class="activity-card__meta">
      <time datetime={activity.date}>{formattedDate}</time>
      <span aria-hidden="true">·</span>
      <span>{activity.location}</span>
    </div>
    <h3>{activity.title}</h3>
    <p>{activity.description}</p>

    {activityLink && (
      <a class="activity-card__link" href={activityLink} target="_blank" rel="noreferrer">
        {activity.links?.eventPage ? 'Event details' : 'Watch video'}
        <span aria-hidden="true"> →</span>
      </a>
    )}
  </div>
</article>

<style>
  .activity-card {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 11rem) 1fr;
    overflow: hidden;
    border: 1px solid var(--border-subtle, #30363d);
    border-radius: 1rem;
    background: var(--surface-2, #161b22);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .activity-card:hover,
  .activity-card:focus-within {
    transform: translateY(-2px);
    box-shadow: 0 12px 28px rgb(0 0 0 / 20%);
  }

  .activity-card__marker {
    position: absolute;
    top: 1.25rem;
    left: 1rem;
    width: 0.7rem;
    height: 0.7rem;
    border: 2px solid var(--color-accent, #58a6ff);
    border-radius: 50%;
    background: var(--surface-2, #161b22);
    transform: translateX(-50%);
  }

  .activity-card__image { width: 100%; height: 100%; min-height: 9rem; object-fit: cover; }
  .activity-card__content { display: flex; flex-direction: column; gap: 0.55rem; padding: 1.25rem 1.5rem; }
  .activity-card__meta { display: flex; flex-wrap: wrap; gap: 0.45rem; color: var(--foreground-500, #8b949e); font-size: 0.85rem; }
  h3, p { margin: 0; }
  h3 { color: var(--foreground-900, #f0f6fc); font-size: 1.2rem; }
  p { color: var(--foreground-600, #8b949e); line-height: 1.6; }
  .activity-card__link { align-self: flex-start; color: var(--primary-foreground, #58a6ff); font-weight: 600; text-decoration: none; }
  .activity-card__link:hover, .activity-card__link:focus-visible { text-decoration: underline; }

  @media (max-width: 639px) {
    .activity-card { grid-template-columns: 1fr; }
    .activity-card__marker { top: 1rem; left: 1rem; }
    .activity-card__image { max-height: 12rem; }
    .activity-card__content { padding: 1rem 1.15rem 1.15rem; }
  }

  @media (prefers-reduced-motion: reduce) { .activity-card { transition: none; } }
</style>
