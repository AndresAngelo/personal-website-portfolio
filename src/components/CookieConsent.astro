<aside id="cookie-consent" class="cookie-consent" aria-label="Cookie preferences" hidden>
  <div class="cookie-card" role="dialog" aria-modal="false" aria-labelledby="cookie-title" aria-describedby="cookie-description">
    <div>
      <p class="cookie-eyebrow">Privacy choices</p>
      <h2 id="cookie-title">Control your cookies</h2>
      <p id="cookie-description">We use only essential storage to remember site preferences. Optional cookies are off unless you choose to allow them. Read our <a href="/privacy-policy#cookies">cookie policy</a>.</p>
    </div>
    <div class="cookie-actions">
      <button type="button" data-cookie-reject>Reject optional</button>
      <button type="button" class="cookie-primary" data-cookie-accept>Accept optional</button>
    </div>
  </div>
</aside>

<button id="cookie-settings" class="cookie-settings" type="button" aria-label="Open cookie preferences" hidden>Cookie settings</button>

<script>
  const STORAGE_KEY = 'aea-cookie-consent';
  const banner = document.querySelector('#cookie-consent');
  const settings = document.querySelector('#cookie-settings');
  const accept = document.querySelector('[data-cookie-accept]');
  const reject = document.querySelector('[data-cookie-reject]');

  if (banner instanceof HTMLElement && settings instanceof HTMLButtonElement) {
    const show = () => { banner.hidden = false; settings.hidden = true; };
    const hide = () => { banner.hidden = true; settings.hidden = false; };
    const save = (value) => { window.localStorage.setItem(STORAGE_KEY, value); hide(); };
    let preference = null;
    try { preference = window.localStorage.getItem(STORAGE_KEY); } catch { /* Storage may be blocked. */ }
    if (preference === 'accepted' || preference === 'rejected') hide(); else show();
    accept?.addEventListener('click', () => save('accepted'));
    reject?.addEventListener('click', () => save('rejected'));
    settings.addEventListener('click', show);
  }
</script>

<style>
  .cookie-consent { position: fixed; inset: auto 1rem 1rem; z-index: 60; }
  .cookie-card { display: flex; gap: 1.25rem; align-items: end; justify-content: space-between; max-width: 58rem; margin: 0 auto; padding: 1rem 1.15rem; border: 1px solid rgb(129 140 248 / .45); border-radius: .9rem; background: rgb(15 23 42 / .97); box-shadow: 0 1.25rem 3rem rgb(0 0 0 / .35); }
  .cookie-eyebrow { margin: 0 0 .2rem; color: #a5b4fc; font-size: .7rem; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; }
  .cookie-card h2 { margin: 0; color: #f8fafc; font-size: 1rem; }
  .cookie-card p:not(.cookie-eyebrow) { max-width: 42rem; margin: .35rem 0 0; color: #cbd5e1; font-size: .85rem; line-height: 1.5; }
  .cookie-card a, .cookie-settings { color: #c4b5fd; text-decoration: underline; }
  .cookie-actions { display: flex; flex: 0 0 auto; gap: .5rem; }
  .cookie-actions button, .cookie-settings { border: 1px solid rgb(148 163 184 / .45); border-radius: .5rem; background: transparent; color: #e2e8f0; cursor: pointer; font: inherit; font-size: .8rem; padding: .55rem .75rem; }
  .cookie-actions .cookie-primary { border-color: #818cf8; background: #4f46e5; color: white; }
  .cookie-actions button:focus-visible, .cookie-settings:focus-visible { outline: 2px solid #a5b4fc; outline-offset: 2px; }
  .cookie-settings { position: fixed; bottom: 1rem; left: 1rem; z-index: 59; background: rgb(15 23 42 / .95); }
  @media (max-width: 40rem) { .cookie-card { align-items: stretch; flex-direction: column; } .cookie-actions { justify-content: flex-end; } }
</style>
