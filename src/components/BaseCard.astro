---
interface CardProps {
  id: string;
  title: string;
  description: string;
  tags?: string[];
  image?: string;
  link?: string;
}

const { id, title, description, tags = [], image, link } = Astro.props;
---

<article class="project-card" id={id}>
  {#if image}
    <img
      src={image}
      alt=""
      loading="lazy"
      decoding="async"
      width={400}
      height={300}
    />
  {/if}

  <div class="card-content">
    <h3>{title}</h3>
    <p>{description}</p>

    {#if tags && tags.length > 0}
      <ul role="list" aria-label="Tags">
        {#each tags as tag}
          <li class="tag">{tag}</li>
        {/each}
      </ul>
    {/if}

    {#if link}
      <a href={link} target="_blank" rel="noopener noreferrer">
        View Project →
      </a>
    {/if}
  </div>
</article>

<style is:global scope="base-card">
  .project-card {
    display: flex;
    flex-direction: column;
    background-color: var(--surface-2);
    border-radius: 1rem;
    overflow: hidden;
    border: 1px solid var(--border-subtle);
    transition:
      box-shadow 0.3s ease,
      transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1),
      border-color 0.2s ease;
  }

  .project-card:hover {
    box-shadow: 0 12px 28px rgba(0, 0, 0, 0.12);
    transform: translateY(-3px) scale(1.015);
    border-color: var(--primary-subtle);
    z-index: 1;
  }

  .project-card:focus-within {
    box-shadow: 0 12px 28px rgba(var(--primary-rgb), 0.16);
    transform: translateY(-3px) scale(1.015);
    border-color: var(--primary-subtle);
    z-index: 1;
  }

  .project-card img {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    display: block;
  }

  .card-content {
    padding: clamp(0.75rem, 1.5vw, 1rem);
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: clamp(0.4rem, 1vw, 0.6rem);
  }

  .card-content h3 {
    font-size: clamp(1.05rem, 2vw, 1.25rem);
    margin: 0;
    line-height: 1.35;
    color: var(--foreground-900);
  }

  .card-content > p {
    font-size: clamp(0.875rem, 1.75vw, 0.95rem);
    margin: 0;
    line-height: 1.6;
    color: var(--foreground-600);
  }

  .tag-list {
    display: flex;
    flex-wrap: wrap;
    gap: clamp(0.375rem, 0.8vw, 0.5rem);
    margin-top: auto;
  }

  .tag {
    font-size: clamp(0.7rem, 1.25vw, 0.75rem);
    padding: 0.2em 0.6em;
    border-radius: 999px;
    background-color: var(--surface-3);
    color: var(--foreground-500);
    font-weight: 500;
    transition: background-color 0.2s ease, color 0.2s ease;
  }

  .tag:hover {
    background-color: var(--primary-subtle);
    color: var(--primary-foreground);
  }

  .card-link {
    margin-top: clamp(0.5rem, 1vw, 0.75rem);
    font-size: clamp(0.85rem, 1.6vw, 0.9rem);
    color: var(--primary-foreground);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 0.3em;
    font-weight: 500;
    transition: color 0.2s ease, text-decoration-color 0.2s ease;
  }

  .card-link:hover,
  .card-link:focus {
    color: var(--primary-foreground);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }
</style>