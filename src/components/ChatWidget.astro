---
import ChatHeader from './ChatHeader.astro';
import ChatMessages from './ChatMessages.astro';
import ChatInput from './ChatInput.astro';
import StreamingIndicator from './StreamingIndicator.astro';

const welcomeMessage = {
  role: 'assistant' as const,
  content: 'Ask me about projects, experience, or how this portfolio was built.',
};
---

<aside class="chat-widget" data-chat-widget>
  <button class="chat-launcher" id="chat-toggle" type="button" aria-controls="chat-panel" aria-expanded="false" aria-label="Open portfolio assistant"><span aria-hidden="true">✦</span><span>Ask me</span><span class="chat-unread" aria-label="New assistant message">1</span></button>
  <section class="chat-panel" id="chat-panel" aria-labelledby="chat-title" aria-hidden="true" hidden>
    <ChatHeader />
    <ChatMessages messages={[welcomeMessage]} />
    <StreamingIndicator />
    <ChatInput />
  </section>
</aside>
<script>
  const widget = document.querySelector<HTMLElement>('[data-chat-widget]');
  if (widget) {
    void import('../scripts/chat-widget').then(({ initChatWidget }) => initChatWidget(widget));
  }
</script>
<style>
  .chat-widget { position: fixed; right: max(clamp(1rem, 3vw, 2rem), env(safe-area-inset-right)); bottom: max(clamp(1rem, 3vw, 2rem), env(safe-area-inset-bottom)); z-index: 200; }
  .chat-launcher, .chat-close { border: 0; cursor: pointer; font: inherit; }
  .chat-launcher { display: inline-flex; align-items: center; gap: .5rem; min-height: 3rem; padding: .75rem 1rem; border-radius: 999px; color: white; background: linear-gradient(135deg, #4f46e5, #9333ea); box-shadow: 0 .75rem 2rem rgb(15 23 42 / 35%); font-weight: 700; transition: transform 180ms ease, box-shadow 180ms ease; }
  .chat-launcher:hover { transform: translateY(-2px); }
  .chat-unread { display: grid; place-items: center; width: 1.25rem; height: 1.25rem; border-radius: 50%; color: #312e81; background: white; font-size: .75rem; }
  .chat-panel { position: absolute; right: 0; bottom: 4.25rem; display: flex; flex-direction: column; width: min(22rem, calc(100vw - 2rem)); height: min(34rem, calc(100dvh - 6rem)); min-height: 20rem; overflow: hidden; border: 1px solid rgb(148 163 184 / 25%); border-radius: 1rem; color: #e2e8f0; background: #172033; box-shadow: 0 1.5rem 3rem rgb(2 6 23 / 45%); animation: chat-panel-in 180ms ease-out; }
  .chat-panel-body { flex: 1; padding: 1.25rem; color: #cbd5e1; font-size: .9rem; }
  .chat-panel-body p { margin: 0; }
  @keyframes chat-panel-in { from { opacity: 0; transform: translateY(.5rem) scale(.98); } to { opacity: 1; transform: translateY(0) scale(1); } }
  @media (max-width: 480px) {
    .chat-widget { right: max(.75rem, env(safe-area-inset-right)); bottom: max(.75rem, env(safe-area-inset-bottom)); }
    .chat-launcher { min-height: 3.25rem; padding-inline: .9rem; }
    .chat-panel { position: fixed; inset: max(.5rem, env(safe-area-inset-top)) max(.5rem, env(safe-area-inset-right)) max(5rem, calc(env(safe-area-inset-bottom) + 4.5rem)) max(.5rem, env(safe-area-inset-left)); width: auto; height: auto; min-height: 0; border-radius: .85rem; }
  }
  @media (max-width: 360px) { .chat-launcher > span:nth-child(2) { display: none; } .chat-panel { inset-inline: .25rem; } }
  @media (prefers-reduced-motion: reduce) { .chat-panel, .chat-launcher { animation: none; transition: none; } }
</style>
