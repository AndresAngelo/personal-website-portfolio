---
interface EmptyStateProps {
  message?: string;
  icon?: 'briefcase' | 'inbox' | 'mail' | 'clock';
}

const { message = "No items yet.", icon = "inbox" } = Astro.props;
---

<div class="empty-state" role="status">
  <svg viewBox="0 0 24 24" width="64" height="64" aria-hidden="true">
    {icon === 'briefcase' ? (
      <path fill="currentColor" d="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-7 9h-2V7h2v5z" />
    ) : icon === 'inbox' ? (
      <path fill="currentColor" d="M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z" />
    ) : icon === 'mail' ? (
      <path fill="currentColor" d="M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5v3.09c1.39.12 2.79.69 3.91 1.71L14 15.4V18h2v-3l1.1-.74C17.21 13.25 18.61 12.68 20 12.09V6z" />
    ) : (
      <path fill="currentColor" d="M11.99 2C6.47 2 2 6.48 2 12s4.47 10 9.99 10C17.52 22 22 17.52 22 12S17.52 2 11.99 2zm6.93 6h-2.95c-.35-1.28-1.4-2.29-2.75-2.5V3L13 4v2c0 .82.34 1.56.89 2.09l2.7 2.7v.7c-.22.04-.45.06-.69.06H12v4h-2v-4H7.5c-.24 0-.47-.02-.69-.06V8.7l2.7-2.7C9.56 5.46 9.9 4.72 9.9 3.99V3L10.7 2h2.6c-.06.26-.09.53-.08.8l.02.4v2H11v2h2v-1.6z" />
    )}
  </svg>
  <p>{message}</p>
</div>

<style is:global scope="empty-state">
  .empty-state {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 20rem;
    color: var(--foreground-muted);
    font-size: clamp(1rem, 2vw, 1.25rem);
    text-align: center;
    padding: clamp(2rem, 4vw, 3rem) clamp(1rem, 2vw, 2.5rem);
    background-color: var(--surface-1);
    border-radius: 0.75em;
    border: 1px dashed var(--border-subtle);
  }

  .empty-state svg {
    margin-bottom: clamp(0.5rem, 1vw, 0.75rem);
    opacity: 0.6;
  }

  .empty-state p {
    margin: 0;
  }
</style>
---
